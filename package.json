{
  "name": "sound-party-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test:recording": "node tests/recording-api.mjs",
    "db:generate": "drizzle-kit generate",
    "format": "oxfmt src server shared scripts tests db index.html vite.config.ts tsconfig.json package.json drizzle.config.ts",
    "format:check": "oxfmt --check src server shared scripts tests db index.html vite.config.ts tsconfig.json package.json drizzle.config.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "preact": "^10.27.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.25.0",
    "oxfmt": "^0.79.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
